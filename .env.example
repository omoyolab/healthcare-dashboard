# Copy to .env before `docker compose up`. These are development defaults;
# nothing here is a real secret.

# --- database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthcare
# localhost works when you run the API on your machine; compose overrides this
# to the service name "db" inside the network.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- api ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
SEED_ON_STARTUP=true

# --- frontend (baked into the bundle at build time, so never secret) ---
# Empty means same-origin: the dev server and nginx both proxy /api to the API,
# so the browser never makes a cross-origin request. Set an absolute URL only to
# point the UI at an API on another host.
VITE_API_BASE_URL=
